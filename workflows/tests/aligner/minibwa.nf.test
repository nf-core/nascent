nextflow_pipeline {

    name "MiniBWA"
    script "../../../main.nf"
    tag "aligner"
    tag "minibwa"

    test("Should run with defaults") {
        // PINTS can fail on tiny MiniBWA test BAMs; this test covers aligner wiring.
        config '../skip_pints.config'

        when {
            params {
                outdir = "$outputDir"
                aligner = "minibwa"
                input = "${projectDir}/assets/samplesheet.csv"
            }
        }

        then {
            assertAll(
                { assert workflow.success },
            )
        }
    }
}
